                options: ["왜로 가는 척 기습", "육로(신라)와 수로(당)로 사비성을 동시에 동서에서 협공하는 작전", "사비성 장기 포위", "왕 유인 생포"],
                correctIdx: 1
            },
            {
                section: 4,
                secTitle: "4장: 의자왕의 실정과 백제 멸망",
                qId: "q4_5",
                qNum: "5",
                qText: "이후 백제의 상황은 어떠했나요? 교과서에서 찾아봅시다.",
                answer: "계백 장군이 5천 결사대로 황산벌에서 항전했으나 패배하였고, 사비성이 함락되어 660년 백제는 멸망했습니다. 이후 흑치상지, 복신, 도침 등을 중심으로 백제 부흥운동이 일어났습니다.",
                options: ["백제가 격퇴하고 삼국 통일", "계백의 황산벌 패배 후 사비성이 함락되어 백제가 멸망하고, 이후 부흥운동이 전개됨", "평화 협정 체결", "신라가 백제 구원"],
                correctIdx: 1
            }
        ];

        // Initialization
        document.addEventListener('DOMContentLoaded', () => {
            renderWorkbookCards();
            renderQuizItems();
            loadSavedAnswers();
            updateWriteProgress();
        });

        // Render Workbook Cards (With Input Textareas!)
        function renderWorkbookCards() {
            for (let i = 1; i <= 4; i++) {
                const container = document.getElementById(`cards-sec${i}`);
                const filtered = historicalData.filter(item => item.section === i);
                
                container.innerHTML = filtered.map(item => `
                    <div class="card-box bg-white border border-stone-300 rounded-xl p-5 shadow-sm space-y-4">
                        <!-- Question Header -->
                        <div class="flex justify-between items-start gap-2">
                            <div class="flex items-center gap-2">
                                <span class="bg-history-navy text-amber-300 text-xs px-2.5 py-1 rounded-md font-bold font-history shrink-0">
                                    질문 ${item.qNum}
                                </span>
                                <h3 class="font-bold text-stone-800 text-base sm:text-lg">
                                    ${item.qText}
                                </h3>
                            </div>
                        </div>

                        <!-- User Input Area (Textarea) -->
                        <div class="space-y-1.5 no-print">
                            <label for="input-${item.qId}" class="block text-xs font-semibold text-stone-600">
                                <i class="fa-solid fa-pen-line text-history-gold mr-1"></i> 나의 답안 작성하기:
                            </label>
                            <textarea 
                                id="input-${item.qId}" 
                                oninput="handleInput('${item.qId}')"
                                rows="3" 
                                class="w-full p-3 text-sm text-stone-800 bg-amber-50/30 border border-stone-300 rounded-lg focus:ring-2 focus:ring-history-gold focus:border-history-gold outline-none transition-all placeholder:text-stone-400 font-sans"
                                placeholder="이 질문에 대한 생각이나 정답을 직접 작성해 보세요..."></textarea>
                        </div>

                        <!-- Print Version Answer Display -->
                        <div class="hidden print-only text-sm text-stone-900 border p-3 rounded bg-stone-50">
                            <strong>[내가 작성한 답안]</strong> <br>
                            <span id="print-val-${item.qId}">(미작성)</span>
                        </div>

                        <!-- Buttons & Action -->
                        <div class="no-print flex items-center justify-between pt-1">
                            <span id="save-status-${item.qId}" class="text-xs text-stone-400 font-medium"></span>
                            <button onclick="toggleAnswer('${item.qId}')" class="text-xs px-3 py-1.5 bg-amber-100 hover:bg-amber-200 text-history-darkGold font-bold rounded-lg transition-colors flex items-center gap-1.5">
                                <i class="fa-solid fa-lightbulb"></i> <span id="btn-text-${item.qId}">정답/해설 확인</span>
                            </button>
                        </div>
                        
                        <!-- Model Answer & Solution Box -->
                        <div id="ans-box-${item.qId}" class="answer-text hidden pt-3 border-t border-stone-200 text-sm space-y-2">
                            <div class="p-4 bg-stone-50 border-l-4 border-history-gold rounded-r-lg text-stone-800 leading-relaxed font-medium">
                                <span class="text-history-accentRed font-bold block mb-1">
                                    <i class="fa-solid fa-bookmark mr-1"></i> [모범 답안 및 핵심 해설]
                                </span>
                                ${item.answer}
                            </div>
                        </div>
                    </div>
                `).join('');
            }
        }

        // Render Multiple Choice Quiz List
        function renderQuizItems() {
            const listContainer = document.getElementById('quiz-questions-list');
            listContainer.innerHTML = historicalData.map((item, index) => `
                <div class="bg-white p-5 rounded-xl border border-stone-200 shadow-sm space-y-4" id="quiz-card-${index}">
                    <div class="flex items-start justify-between gap-3">
                        <span class="text-xs bg-stone-100 text-stone-600 px-2.5 py-1 rounded font-semibold shrink-0">
                            문제 ${index + 1} (${item.secTitle})
                        </span>
                        <span id="quiz-status-${index}" class="text-xs font-bold px-2 py-0.5 rounded hidden"></span>
                    </div>
                    <p class="font-bold text-stone-800 text-base sm:text-lg">
                        ${item.qText}
                    </p>
                    
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 pt-1">
                        ${item.options.map((opt, oIdx) => `
                            <label class="flex items-center p-3 rounded-lg border border-stone-200 hover:bg-amber-50/50 cursor-pointer text-xs sm:text-sm transition-all">
                                <input type="radio" name="quiz-q-${index}" value="${oIdx}" onchange="updateQuizProgress()" class="w-4 h-4 text-history-navy focus:ring-history-gold mr-3">
                                <span class="text-stone-700 font-medium">${opt}</span>
                            </label>
                        `).join('')}
                    </div>

                    <div id="quiz-feedback-${index}" class="hidden p-3 rounded-lg text-xs sm:text-sm mt-2"></div>
                </div>
            `).join('');
        }

        // Input & LocalStorage Logic
        function handleInput(qId) {
            const inputVal = document.getElementById(`input-${qId}`).value;
            localStorage.setItem(`baekje_ans_${qId}`, inputVal);
            
            // Print display update
            const printElem = document.getElementById(`print-val-${qId}`);
            if (printElem) printElem.textContent = inputVal.trim() !== '' ? inputVal : '(미작성)';

            // Status Indicator
            const statusElem = document.getElementById(`save-status-${qId}`);
            if (statusElem) {
                statusElem.textContent = "저장됨";
                statusElem.classList.add('text-emerald-600');
                setTimeout(() => {
                    statusElem.textContent = "";
                }, 1500);
            }

            updateWriteProgress();
        }

        function loadSavedAnswers() {
            historicalData.forEach(item => {
                const saved = localStorage.getItem(`baekje_ans_${item.qId}`);
                if (saved !== null) {
                    const inputElem = document.getElementById(`input-${item.qId}`);
                    if (inputElem) inputElem.value = saved;

                    const printElem = document.getElementById(`print-val-${item.qId}`);
                    if (printElem) printElem.textContent = saved.trim() !== '' ? saved : '(미작성)';
                }
            });
        }

        function updateWriteProgress() {
            let writtenCount = 0;
            historicalData.forEach(item => {
                const val = localStorage.getItem(`baekje_ans_${item.qId}`);
                if (val && val.trim().length > 0) {
                    writtenCount++;
                }
            });
            document.getElementById('write-progress-text').textContent = `${writtenCount} / ${historicalData.length}`;
        }

        function clearAllInputs() {
            if (confirm("작성하신 모든 서술형 답안을 삭제하고 초기화하시겠습니까?")) {
                historicalData.forEach(item => {
                    localStorage.removeItem(`baekje_ans_${item.qId}`);
                    const inputElem = document.getElementById(`input-${item.qId}`);
                    if (inputElem) inputElem.value = "";
                    const printElem = document.getElementById(`print-val-${item.qId}`);
                    if (printElem) printElem.textContent = "(미작성)";
                });
                updateWriteProgress();
            }
        }

        // Answer Toggle Functions
        function toggleAnswer(qId) {
            const box = document.getElementById(`ans-box-${qId}`);
            const btnText = document.getElementById(`btn-text-${qId}`);
            if (box.classList.contains('hidden')) {
                box.classList.remove('hidden');
                btnText.textContent = '해설 닫기';
            } else {
                box.classList.add('hidden');
                btnText.textContent = '정답/해설 확인';
            }
        }

        function toggleAllAnswers(show) {
            historicalData.forEach(item => {
                const box = document.getElementById(`ans-box-${item.qId}`);
                const btnText = document.getElementById(`btn-text-${item.qId}`);
                if (show) {
                    box.classList.remove('hidden');
                    btnText.textContent = '해설 닫기';
                } else {
                    box.classList.add('hidden');
                    btnText.textContent = '정답/해설 확인';
                }
            });
        }

        // Tab Navigation & Scroll
        function switchMode(mode) {
            const studyCont = document.getElementById('study-mode-container');
            const quizCont = document.getElementById('quiz-mode-container');
            const btnStudy = document.getElementById('btn-study-mode');
            const btnQuiz = document.getElementById('btn-quiz-mode');

            if (mode === 'study') {
                studyCont.classList.remove('hidden');
                quizCont.classList.add('hidden');
                btnStudy.className = "px-3 py-2 sm:px-4 sm:py-2 rounded-lg bg-history-gold text-history-navy font-semibold text-xs sm:text-sm transition-all shadow-md flex items-center gap-1.5 hover:bg-amber-300";
                btnQuiz.className = "px-3 py-2 sm:px-4 sm:py-2 rounded-lg bg-history-lightNavy text-amber-200 hover:bg-slate-700 font-semibold text-xs sm:text-sm transition-all flex items-center gap-1.5 border border-amber-500/30";
            } else {
                studyCont.classList.add('hidden');
                quizCont.classList.remove('hidden');
                btnQuiz.className = "px-3 py-2 sm:px-4 sm:py-2 rounded-lg bg-history-gold text-history-navy font-semibold text-xs sm:text-sm transition-all shadow-md flex items-center gap-1.5 hover:bg-amber-300";
                btnStudy.className = "px-3 py-2 sm:px-4 sm:py-2 rounded-lg bg-history-lightNavy text-amber-200 hover:bg-slate-700 font-semibold text-xs sm:text-sm transition-all flex items-center gap-1.5 border border-amber-500/30";
            }
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function scrollToSection(secId) {
            const el = document.getElementById(secId);
            if (el) el.scrollIntoView({ behavior: 'smooth' });
        }

        // Quiz Mode Scoring
        function updateQuizProgress() {
            let answered = 0;
            historicalData.forEach((_, idx) => {
                if (document.querySelector(`input[name="quiz-q-${idx}"]:checked`)) answered++;
            });
            document.getElementById('answered-count').textContent = answered;
        }

        function gradeQuiz() {
            let correctCount = 0;
            const total = historicalData.length;

            historicalData.forEach((item, idx) => {
                const selected = document.querySelector(`input[name="quiz-q-${idx}"]:checked`);
                const feedbackBox = document.getElementById(`quiz-feedback-${idx}`);
                const statusBadge = document.getElementById(`quiz-status-${idx}`);

                feedbackBox.classList.remove('hidden', 'bg-emerald-50', 'bg-rose-50', 'text-emerald-800', 'text-rose-800');
                statusBadge.classList.remove('hidden', 'bg-emerald-100', 'text-emerald-800', 'bg-rose-100', 'text-rose-800');

                if (selected && parseInt(selected.value) === item.correctIdx) {
                    correctCount++;
                    statusBadge.textContent = "정답";
                    statusBadge.classList.add('bg-emerald-100', 'text-emerald-800');
                    feedbackBox.classList.add('bg-emerald-50', 'text-emerald-800', 'border', 'border-emerald-200');
                    feedbackBox.innerHTML = `<strong><i class="fa-solid fa-circle-check text-emerald-600 mr-1"></i> 정답입니다!</strong><br><span class="text-xs mt-1 block">${item.answer}</span>`;
                } else {
                    statusBadge.textContent = "오답";
                    statusBadge.classList.add('bg-rose-100', 'text-rose-800');
                    feedbackBox.classList.add('bg-rose-50', 'text-rose-800', 'border', 'border-rose-200');
                    feedbackBox.innerHTML = `<strong><i class="fa-solid fa-circle-xmark text-rose-600 mr-1"></i> 오답입니다.</strong> (정답: ${item.options[item.correctIdx]})<br><span class="text-xs mt-1 block">${item.answer}</span>`;
                }
            });

            const score = Math.round((correctCount / total) * 100);
            document.getElementById('final-score').textContent = score;

            const feedbackElem = document.getElementById('result-feedback');
            if (score === 100) feedbackElem.textContent = "완벽합니다! 백제 시대 역사를 명확하게 파악하고 계시네요.";
            else if (score >= 70) feedbackElem.textContent = "훌륭합니다! 서술형 워크북에서 틀린 개념을 한번 더 복습해보세요.";
            else feedbackElem.textContent = "서술형 워크북의 해설을 참고하여 기본 개념을 다시 점검해 보세요!";

            const resultCard = document.getElementById('quiz-result-card');
            resultCard.classList.remove('hidden');
            resultCard.scrollIntoView({ behavior: 'smooth' });
        }

        function resetQuiz() {
            document.getElementById('quiz-form').reset();
            historicalData.forEach((_, idx) => {
                document.getElementById(`quiz-feedback-${idx}`).classList.add('hidden');
                document.getElementById(`quiz-status-${idx}`).classList.add('hidden');
            });
            document.getElementById('quiz-result-card').classList.add('hidden');
            updateQuizProgress();
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }
    </script>
</body>
</html>